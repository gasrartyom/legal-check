# Copy to .env.local for local development. Never commit real values.

# Anthropic API key used by /api/check. Required. On Vercel: mark as Sensitive.
LEGAL_CHECK_API_KEY=

# Optional model override; leave empty for the site default (claude-opus-5-5).
# Tests use the cheap one: LEGAL_CHECK_MODEL=claude-haiku-5-5
LEGAL_CHECK_MODEL=

# Upstash Redis (REST) for the 3-checks-a-day limit. Required on Vercel: without it the limit is
# kept per server instance and is not reliable. The Vercel Marketplace integration sets these;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too.
KV_REST_API_URL=
KV_REST_API_TOKEN=
